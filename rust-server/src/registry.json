    {"name": "Augment",          "paths": ["~/.augment"]},
    {"name": "Tabby",            "paths": ["~/.tabby"]},
    {"name": "Mentat",           "paths": ["~/.mentat"]},
    {"name": "Sweep",            "paths": [], "note": "no local transcripts known"},
    {"name": "Bloop",            "paths": []},
    {"name": "Sourcery",         "paths": []},
