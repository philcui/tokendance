    {"name": "Double",           "paths": []},
    {"name": "Codebuff",         "paths": ["~/.codebuff"]},
    {"name": "Cody CLI",         "paths": []},
    {"name": "Kimi CLI",         "paths": [], "note": "same store as Kimi Code, so it is searched by name instead"},
    {"name": "Trae Solo",        "paths": ["~/Library/Application Support/TRAE SOLO CN"]},
    {"name": "Windsurf Next",    "paths": ["~/Library/Application Support/Windsurf - Next"]},
    {"name": "Cursor Nightly",   "paths": ["~/Library/Application Support/Cursor Nightly"]}
