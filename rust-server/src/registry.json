{
  "version": 1,
  "updated": "2026-09-15",
  "note": "Seed registry for source discovery. Tier 1 = entries with paths (checked cheaply); tier 2 = entries with a name only (searched by name); tier 3 = recursive content scan over the standard locations. Entries here are *things to look for*, never claims of support.",
  "sources": [
    {"name": "Codex",            "paths": ["$CODEX_HOME", "~/.codex"],                       "note": "CLI + desktop (the macOS ChatGPT app carries bundle id com.openai.codex)"},
    {"name": "Claude Code",      "paths": ["$CLAUDE_CONFIG_DIR", "~/.claude"],                "note": "transcripts under projects/, three depths"},
    {"name": "WorkBuddy",        "paths": ["~/.workbuddy"],                                   "note": "projects/*/*.jsonl"},
    {"name": "OpenCode",         "paths": ["$XDG_DATA_HOME/opencode", "~/.local/share/opencode"], "note": "SQLite: session.tokens_*"},
    {"name": "pi",               "paths": ["~/.pi"],                                          "note": "agent/sessions/*/*.jsonl"},
    {"name": "Qwen Code",        "paths": ["~/.qwen"],                                        "note": "gemini-cli fork"},
    {"name": "Kimi Code",        "paths": ["~/.kimi-code", "~/.kimi"],                        "note": "wire.jsonl / context.jsonl"},
    {"name": "iFlow",            "paths": ["~/.iflow"],                                       "note": "gemini-cli fork"},
    {"name": "Qoder",            "paths": ["~/.qoder"],                                       "note": "projects/ + logs/sessions/"},
    {"name": "Antigravity",      "paths": ["~/.gemini/antigravity", "~/.gemini/antigravity-ide"], "note": "one SQLite per conversation; usage is protobuf, mapping unconfirmed"},
    {"name": "Goose",            "paths": ["~/.local/state/goose", "~/.config/goose"],         "note": "logs/llm_request.*.jsonl (found by content scan on this machine)"},
    {"name": "VClaw",            "paths": ["~/Library/Application Support/VClaw"],             "note": ".openclaw/agents/main/sessions/*.jsonl"},
    {"name": "Cline",            "paths": ["~/.cline", "~/Library/Application Support/cline"], "note": "tasks/<id>/*.json (whole-file JSON, not read yet)"},
    {"name": "Roo Code",         "paths": ["~/Library/Application Support/Code/User/globalStorage/rooveterinaryinc.roo-cline"]},
    {"name": "Continue",         "paths": ["~/.continue"]},
    {"name": "Kilo Code",        "paths": ["~/.kilocode", "~/Library/Application Support/Code/User/globalStorage/kilocode.kilo-code"], "note": "list from npm (@kilocode/cli)"},
    {"name": "Aider",            "paths": ["~/.aider", "~/.aider.conf.yml"]},
    {"name": "Crush",            "paths": ["~/.crush", "~/.config/crush"]},
    {"name": "Amp",              "paths": ["~/.amp", "~/.config/amp"]},
    {"name": "OpenHands",        "paths": ["~/.openhands", "~/.config/openhands"]},
    {"name": "Plandex",          "paths": ["~/.plandex"]},
    {"name": "Cursor",           "paths": ["~/Library/Application Support/Cursor"],           "note": "state.vscdb; only 8 of 3792 bubbles carry usage"},
    {"name": "Windsurf",         "paths": ["~/.windsurf", "~/Library/Application Support/Windsurf"]},
    {"name": "Trae",             "paths": ["~/Library/Application Support/Trae"]},
    {"name": "CodeBuddy",        "paths": ["~/.codebuddy", "~/Library/Application Support/CodeBuddy CN"]},
    {"name": "GitHub Copilot",   "paths": ["~/.copilot", "~/Library/Application Support/Code/User/globalStorage/github.copilot-chat"], "note": "lmBaseCount/<model> = request counts, no tokens"},
    {"name": "通义灵码",          "paths": ["~/.lingma"],                                        "note": "SQLite has sessions but no token columns"},
    {"name": "CodeGeeX",         "paths": ["~/.codegeex"]},
    {"name": "Marscode",         "paths": ["~/.marscode"]},
    {"name": "Comate",           "paths": ["~/.comate"]},
    {"name": "Tabnine",          "paths": ["~/.tabnine"]},
    {"name": "Cody",             "paths": ["~/.cody", "~/Library/Application Support/Code/User/globalStorage/sourcegraph.cody-ai"]},
    {"name": "Void",             "paths": ["~/.void", "~/Library/Application Support/Void"]},
    {"name": "PearAI",           "paths": ["~/Library/Application Support/PearAI"]},
    {"name": "Zed",              "paths": ["~/.config/zed", "~/.local/share/zed"]},
    {"name": "Warp",             "paths": ["~/.warp", "~/.local/share/warp"]},
    {"name": "OpenClaw",         "paths": ["~/.openclaw", "~/Library/Application Support/OpenClaw"]},
    {"name": "Ollama",           "paths": ["~/.ollama"],                                        "note": "local inference; records no token usage"},
    {"name": "LM Studio",        "paths": ["~/.lmstudio", "~/.cache/lm-studio"]},
    {"name": "Jan",              "paths": ["~/Library/Application Support/Jan"]},
    {"name": "Jan AI",           "paths": ["~/.jan"]},
    {"name": "Msty",             "paths": ["~/Library/Application Support/Msty"]},

    {"name": "Oxe",              "paths": [], "note": "name from npm (@oxecli/oxe) — searched by name"},
